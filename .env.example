# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public app URL used for payment return URLs and webhooks.
APP_URL="https://your-domain.example"

# Cashfree one-time payments
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Firebase Admin service account JSON for server-side Cashfree confirmation/webhooks.
# Keep this value server-only; never prefix it with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=varahi-eat

# Optional comma-separated admin email allowlist used by the current admin UI.
NEXT_PUBLIC_ADMIN_EMAILS=sunkarasivaprasad6@gmail.com
